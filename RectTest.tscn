[gd_scene load_steps=3 format=2]

[ext_resource path="res://gfx/ui/preview_dot.png" type="Texture" id=1]

[sub_resource type="GDScript" id=1]
script/source = "extends Node2D

onready var dot := $Dot as Sprite
onready var dot2 := $Dot2 as Sprite

var line_top:Line2D
var line_right:Line2D
var line_bottom:Line2D
var line_left:Line2D
var lines := []

export var rect:Rect2

func _ready() -> void:
	line_top = Line2D.new()
	lines.append(line_top)
	
	line_right = Line2D.new()
	lines.append(line_right)
	
	line_bottom = Line2D.new()
	lines.append(line_bottom)
	
	line_left = Line2D.new()
	lines.append(line_left)
	
	for l in lines:
		l.add_point(Vector2.ZERO)
		l.add_point(Vector2.ZERO)
		add_child(l)
		move_child(l, 0)

func _process(delta: float) -> void:
	# Move Lines
	var rect_top_right := rect.position + Vector2(rect.size.x, 0.0) 
	var rect_bottom_left := rect.position + Vector2(0.0, rect.size.y)
	
	line_top.points[0] = rect.position
	line_top.points[1] = rect_top_right
	
	line_right.points[0] = rect_top_right
	line_right.points[1] = rect.end
	
	line_bottom.points[0] = rect.end
	line_bottom.points[1] = rect_bottom_left
	
	line_left.points[0] = rect_bottom_left
	line_left.points[1] = rect.position
	
#	var p := dot.position
#	var r_center := rect.position + 0.5 * rect.size
#	var closest_intersect_distance := INF
#	var closest_intersect_line:Line2D
#	var closest_intersect_point:Vector2 = r_center
#	for l in lines:
#		var line:Line2D = l
#		var intersection = Geometry.segment_intersects_segment_2d(r_center, p, line.points[0], line.points[1])
#		if intersection:
#			var intersection_point:Vector2 = intersection
#			var intersection_distance:float = (intersection_point - r_center).length()
#			if intersection_distance < closest_intersect_distance:
#				closest_intersect_distance = intersection_distance
#				closest_intersect_line = line
#				closest_intersect_point = intersection_point
#
#	dot2.position = closest_intersect_point
#	for l in lines:
#		var line:Line2D = l
#		if line == closest_intersect_line:
#			line.self_modulate = Color.white
#		else:
#			line.self_modulate = Color.black
	
	dot2.position = closest_point_on_rectangle_along_vector_from_center(rect, dot.position)
	if Input.is_mouse_button_pressed(BUTTON_LEFT):
		dot.position = get_local_mouse_position()
		
	

static func closest_point_on_rectangle_along_vector_from_center(rect:Rect2, point:Vector2):
	var rect_top_left := rect.position
	var rect_top_right := rect.position + Vector2(rect.size.x, 0.0) 
	var rect_bottom_right := rect.end
	var rect_bottom_left := rect.position + Vector2(0.0, rect.size.y)
	var points := [rect_top_left, rect_top_right, rect_bottom_right, rect_bottom_left]
	var rect_center := rect.position + 0.5 * rect.size
	
	var closest_intersection_point := point
	var closest_intersection_distance := INF
	for i in 4:
		var p1:Vector2 = points[i]
		var p2:Vector2 = points[(i+1) % points.size()]
		var intersection = Geometry.segment_intersects_segment_2d(rect_center, point, p1, p2)
		if intersection:
			var intersection_point:Vector2 = intersection
			var intersection_distance:float = (intersection_point - rect_center).length()
			if intersection_distance < closest_intersection_distance:
				closest_intersection_point = intersection_point
				closest_intersection_distance = intersection_distance
	
	return closest_intersection_point
"

