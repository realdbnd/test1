[input_devices]

pointing/ios/touch_delay=0.0
pointing/emulate_touch_from_mouse=true

[layer_names]

2d_physics/layer_1="terrain"
2d_physics/layer_2="hostile_projectiles"
2d_physics/layer_3="collectibles"
2d_physics/layer_4="minebot_sensor"
2d_physics/layer_5="players"
2d_physics/layer_6="nonhostile_projectiles"
2d_physics/layer_7="barrier"

[logging]

file_logging/enable_file_logging.web=true

[network]

limits/tcp/connect_timeout_seconds=10
limits/debugger_stdout/max_chars_per_second=102400
limits/debugger_stdout/max_messages_per_frame=100
limits/websocket_client/max_in_buffer_kb=512
limits/websocket_client/max_in_packets=256
limits/websocket_client/max_out_packets=64
limits/websocket_server/max_in_packets=64
limits/websocket_server/max_out_packets=64

[physics]

common/physics_jitter_fix=0.0

[rendering]

quality/intended_usage/framebuffer_allocation=4
quality/intended_usage/framebuffer_allocation.mobile=4
threads/thread_model=0
quality/shadows/filter_mode=0
quality/depth_prepass/enable=false
environment/default_clear_color=Color( 0, 0.14, 0.29, 1 )
quality/filters/use_debanding=true
quality/depth/hdr=false
environment/default_environment="res://default_env.tres"
quality/dynamic_fonts/use_oversampling=false
