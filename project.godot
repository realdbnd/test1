[application]

config/name="Rocket Bot Royale"
run/main_scene="res://scenes/SplashScene.tscn"
run/flush_stdout_on_print=true
run/low_processor_mode_sleep_usec=0
boot_splash/show_image=false
boot_splash/fullsize=false
boot_splash/use_filter=false
boot_splash/bg_color=Color( 0, 0, 0, 1 )
config/icon="res://gfx/ui_nonspritesheet/rocket_bot_icon1024.png"
config/macos_native_icon="res://gfx/ui_nonspritesheet/rocket_bot_icon1024.png"
config/windows_native_icon="res://gfx/icon_1024_rbr.ico"
config/quit_on_go_back=false

[audio]

output_latency.web=100

[autoload]

Utilities="*res://scripts/Utilities.gd"
SavedSettings="*res://nodes/SavedSettings.tscn"
FullScreenOnSetting="*res://goodoh/autoloads/FullScreenOnSetting.gd"
ScreenTransitions="*res://ui/nodes/ScreenTransitions.tscn"
TankKingsCursor="*res://nodes/TankKingsCursor.tscn"
Perf="*res://goodoh/perf/Perf.gd"
IOSInstallSource="*res://autoloads/IOSInstallSource.gd"
Nakama="*res://moonlight/nakama-godot/addons/com.heroiclabs.nakama/Nakama.gd"
Moonlight="*res://moonlight/moonlight/Moonlight.gd"
TankKingsMusicPlayer="*res://ui/nodes/TankKingsMusicPlayer.tscn"
FocusGlobal="*res://goodoh/autoloads/FocusGlobal.tscn"
SDFLevelManager="*res://sdfs/SDFLevelManager.gd"
JoypadInputBlocker="*res://goodoh/autoloads/JoypadInputBlocker.gd"
AdManager="*res://scripts/AdManager.gd"
AndroidWinterpixelUtils="*res://moonlight/moonlight/scripts/Moonlight_AndroidWinterpixelUtils.gd"
ReviewRequester="*res://goodoh/utils/ReviewRequester.gd"
SceneCache="*res://scripts/SceneCache.gd"
GoodConfig="*res://goodoh/utils/GoodConfig.gd"
DiscordAuth="*res://moonlight/moonlight/autoloads/DiscordAuth.gd"
EpicController="*res://autoloads/EpicController.gd"

[debug]

settings/profiler/max_functions=65535

[display]

window/size/width=2732
window/size/height=2048
window/dpi/allow_hidpi=true
window/handheld/orientation="sensor_landscape"
window/ios/hide_home_indicator=false
window/stretch/mode="2d"
window/stretch/aspect="expand"

[editor]

convert_text_resources_to_binary_on_export=true

[editor_plugins]

enabled=PoolStringArray( "res://addons/plugin_mouse_coords/plugin.cfg" )

[global]

stdout=false

[gui]

common/default_scroll_deadzone=25
common/snap_controls_to_pixels=false
common/default_scroll_wheel_sensitivity=0.75
common/default_scroll_damping=10.0
common/default_scroll_pan_gesture_sensitivity=0.5
common/default_scroll_sensitivity=0.75

[importer_defaults]

ogg_vorbis={
"loop": false
}

